3, factor=0.5)\n    best_acc = 0.0\n    for epoch in range(1, num_epochs+1):\n        train_loss, train_acc = train_epoch(model, train_loader, optimizer, criterion, device)\n        val_loss, val_acc = validate(model, val_loader, criterion, device)\n        scheduler.step(val_loss)\n        trial.report(val_acc, epoch)\n        if trial.should_prune():\n            raise optuna.TrialPruned()\n        if val_acc > best_acc:\n            best_acc = val_acc\n    return best_acc\n\ndef run_optuna(model, train_loader, val_loader, device, num_epochs=10, n_trials=10):\n    study = optuna.create_study(direction='maximize', pruner=optuna.pruners.MedianPruner())\n    study.optimize(lambda trial: objective(trial, model, train_loader, val_loader, device, num_epochs), n_trials=n_trials)\n    return study.best_params, study.best_value","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T19:49:52.970927Z","iopub.execute_input":"2026-09-01T19:49:52.971259Z","iopub.status.idle":"2026-09-01T19:49:52.987532Z","shell.execute_reply.started":"2026-09-01T19:49:52.971237Z","shell.execute_reply":"2026-09-01T19:49:52.986649Z"}},"outputs":[{"name":"stdout","text":"Writing train.py\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"%%writefile utils.py\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport torch\n\ndef show_frames(dataset, num_videos=2, num_frames=4):\n    fig, axes = plt.subplots(num_videos, num_frames, figsize=(15, 5*num_videos))\n    if num_videos == 1:\n        axes = [axes]\n    for i in range(num_videos):\n        idx = np.random.randint(0, len(dataset))\n        frames, label = dataset[idx]\n        label_str = 'Fake' if label == 1 else 'Real'\n        for j in range(num_frames):\n            img = frames[j].permute(1,2,0).numpy()\n            img = img * np.array([0.229, 0.224, 0.225]) + np.array([0.485, 0.456, 0.406])\n            img = np.clip(img, 0, 1)\n            ax = axes[i][j] if num_videos > 1 else axes[j]\