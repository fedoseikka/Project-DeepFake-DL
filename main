\n        frames = (frames / 255.0 - self.mean) / self.std\n        return frames, label\n\n    def extract_frames(self, video_path):\n        try:\n            vr = VideoReader(video_path, ctx=cpu(0))\n            total_frames = len(vr)\n            if total_frames == 0:\n                return torch.zeros(self.num_frames, 3, self.img_size[0], self.img_size[1])\n            indices = np.linspace(0, total_frames - 1, self.num_frames, dtype=int)\n            frames = vr.get_batch(indices).asnumpy()  # (T, H, W, C)\n            frames = torch.from_numpy(frames).permute(0, 3, 1, 2).float()  # (T, C, H, W)\n            return frames\n        except Exception:\n            return torch.zeros(self.num_frames, 3, self.img_size[0], self.img_size[1])\n\n\n\n\ndef get_data_loaders(\n    data_root,\n    batch_size=32,\n    num_frames=10,\n    img_size=(224, 224),\n    val_split=0.2,\n    max_fake=2000,\n    max_real=2000,\n    num_workers=0,\n    pin_memory=True,\n    device='cuda'\n):\n    fake_dir = os.path.join(data_root, 'Fake')\n    real_dir = os.path.join(data_root, 'Real')\n    fake_videos = [os.path.join(fake_dir, f) for f in os.listdir(fake_dir) if f.endswith('.mp4')]\n    real_videos = [os.path.join(real_dir, f) for f in os.listdir(real_dir) if f.endswith('.mp4')]\n    \n    if max_fake is not None:\n        fake_videos = fake_videos[:max_fake]\n    if max_real is not None:\n        real_videos = real_videos[:max_real]\n    \n    video_paths = fake_videos + real_videos\n    labels = [1] * len(fake_videos) + [0] * len(real_videos)\n    \n    train_paths, val_paths, train_labels, val_labels = train_test_split(\n        video_paths, labels, test_size=val_split, random_state=42, stratify=labels\n    )\n    \n    train_dataset = VideoFrameDataset(train_paths, train_labels, num_frames, img_size, device)\n    val_dataset = VideoFrameDataset(val_paths, val_labels, num_frames, img_size, device)\n    \n    train_loader = DataLoader(\n        train_dataset,\n        batch_size=batch_size,\n        shuffle=True,\n        num_workers=num_workers,\n        pin_memory=pin_memory,\n        prefetch_factor=4 if num_workers > 0 else None\n    )\n    val_loader = DataLoader(\n        val_dataset,\n        batch_size=batch_size,\n        shuffle=False,\n        num_workers=num_workers,\n        pin_memory=pin_memory,\n        prefetch_factor=4 if num_workers > 0 else None\n    )\n    return train_loader, val_loader","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"%%writefile model.py\nimport torch.nn as nn\nfrom torchvision import models\n\nclass VideoClassifier(nn.Module):\n    def __init__(self, num_classes=2, backbone='efficientnet_b0', pretrained=True):\n        super().__init__()\n        if backbone == 'efficientnet_b0':\n            self.backbone = models.efficientnet_b0(pretrained=pretrained)\n            num_features = self.backbone.classifier[1].in_features\n            self.backbone.classifier = nn.Identity()\n        elif backbone == 'resnet50':\n            self.backbone = models.resnet50(pretrained=pretrained)\n            num_features = self.backbone.fc.in_features\n            self.backbone.fc = nn.Identity()\n        elif backbone == 'vit_b_16':\n            self.backbone = models.vit_b_16(pretrained=pretrained)\n            num_features = self.backbone.heads.head.in_features\n            self.backbone.heads = nn.Identity()\n        else:\n            raise ValueError(f'Unsupported backbone: {backbone}')\n        self.fc = nn.Linear(num_features, num_classes)\n\n    def forward(self, x):\n        B, T, C, H, W = x.shape\n        x = x.view(B * T, C, H, W)\n        features = self.backbone(x)\n        features = features.view(B, T, -1)\n        features = features.mean(dim=1)\n        out = self.fc(features)\n        return out","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"%%writefile evaluate.py\nimport torch\nfrom sklearn.metrics import classification_report, confusion_matrix\nimport numpy as np\n\ndef evaluate(model, loader, device):\n    model.eval()\n    all_preds = []\n    all_labels = []\n    with torch.no_grad():\n        for frames, labels in loader:\n            frames = frames.to(device)\n            outputs = model(frames)\n            _, preds = torch.max(outputs, 1)\n            all_preds.extend(preds.cpu().numpy())\n            all_labels.extend(labels.numpy())\n    report = classification_report(all_labels, all_preds, target_names=['Real', 'Fake'])\n    cm = confusion_matrix(all_labels, all_preds)\n    return report, cm, all_preds, all_labels","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"%%writefile utils.py\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport torch\n\ndef show_frames(dataset, num_videos=2, num_frames=4):\n    fig, axes = plt.subplots(num_videos, num_frames, figsize=(15, 5*num_videos))\n    if num_videos == 1:\n        axes = [axes]\n    for i in range(num_videos):\n        idx = np.random.randint(0, len(dataset))\n        frames, label = dataset[idx]\n        label_str = 'Fake' if label == 1 else 'Real'\n        for j in range(num_frames):\n            # Переносим тензор на CPU перед преобразованием в numpy\n            img = frames[j].cpu().permute(1, 2, 0).numpy()\n            img = img * np.array([0.229, 0.224, 0.225]) + np.array([0.485, 0.456, 0.406])\n            img = np.clip(img, 0, 1)\n            ax = axes[i][j] if num_videos > 1 else axes[j]\n            ax.imshow(img)\n            ax.axis('off')\n            if j == 0:\n                ax.set_title(f'{label_str}')\n    plt.tight_layout()\n    plt.show()\n\ndef plot_training_history(train_losses, val_losses, train_accs, val_accs):\n    epochs = range(1, len(train_losses)+1)\n    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14,5))\n    ax1.plot(epochs, train_losses, 'b-', label='Train Loss')\n    ax1.plot(epochs, val_losses, 'r-', label='Val Loss')\n    ax1.set_xlabel('Epoch')\n    ax1.set_ylabel('Loss')\n    ax1.legend()\n    ax1.set_title('Loss over epochs')\n    ax2.plot(epochs, train_accs, 'b-', label='Train Acc')\n    ax2.plot(epochs, val_accs, 'r-', label='Val Acc')\n    ax2.set_xlabel('Epoch')\n    ax2.set_ylabel('Accuracy')\n    ax2.legend()\n    ax2.set_title('Accuracy over epochs')\n    plt.tight_layout()\n    plt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"%%writefile train.py\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom tqdm import tqdm\nimport optuna\nimport os\nimport torch\nimport time\nfrom tqdm import tqdm\n\ndef train_epoch(model, loader, optimizer, criterion, device, profile=False):\n    model.train()\n    total_loss = 0\n    correct = 0\n    total = 0\n    epoch_start = time.time()\n    batch_times = []\n    data_times = []\n    forward_times = []\n    backward_times = []\n    \n    for batch_idx, (frames, labels) in enumerate(tqdm(loader, desc='Training')):\n        batch_start = time.time()\n        \n        # Замер времени загрузки данных\n        data_time = time.time() - batch_start\n        \n        # Перемещение на device\n        frames = frames.to(device, non_blocking=True)\n        labels = labels.to(device, non_blocking=True)\n        torch.cuda.synchronize()  # синхронизация для точного замера\n        \n        forward_start = time.time()\n        optimizer.zero_grad()\n        outputs = model(frames)\n        loss = criterion(outputs, labels)\n        torch.cuda.synchronize()\n        forward_time = time.time() - forward_start\n        \n        backward_start = time.time()\n        loss.backward()\n        optimizer.step()\n        torch.cuda.synchronize()\n        backward_time = time.time() - backward_start\n        \n        total_loss += loss.item() * frames.size(0)\n        _, preds = torch.max(outputs, 1)\n        correct += (preds == labels).sum().item()\n        total += labels.size(0)\n        \n        if profile:\n            batch_times.append(time.time() - batch_start)\n            data_times.append(data_time)\n            forward_times.append(forward_time)\n            backward_times.append(backward_time)\n    \n    epoch_time = time.time() - epoch_start\n    epoch_loss = total_loss / total\n    epoch_acc = correct / total\n    \n    if profile:\n        print(\"\\n=== Profiling Summary ===\")\n        print(f\"Epoch time: {epoch_time:.2f}s\")\n        print(f\"Average batch time: {sum(batch_times)/len(batch_times):.4f}s\")\n        print(f\"Average data loading time: {sum(data_times)/len(data_times):.4f}s\")\n        print(f\"Average forward time: {sum(forward_times)/len(forward_times):.4f}s\")\n        print(f\"Average backward time: {sum(backward_times)/len(backward_times):.4f}s\")\n        print(f\"GPU memory allocated: {torch.cuda.memory_allocated(device)/1e9:.2f} GB\")\n        print(f\"GPU memory reserved: {torch.cuda.memory_reserved(device)/1e9:.2f} GB\")\n    \n    return epoch_loss, epoch_acc\n\ndef validate(model, loader, criterion, device, profile=False):\n    model.eval()\n    total_loss = 0\n    correct = 0\n    total = 0\n    val_start = time.time()\n    with torch.no_grad():\n        for frames, labels in tqdm(loader, desc='Validation'):\n            frames = frames.to(device, non_blocking=True)\n            labels = labels.to(device, non_blocking=True)\n            outputs = model(frames)\n            loss = criterion(outputs, labels)\n            total_loss += loss.item() * frames.size(0)\n            _, preds = torch.max(outputs, 1)\n            correct += (preds == labels).sum().item()\n            total += labels.size(0)\n    val_time = time.time() - val_start\n    epoch_loss = total_loss / total\n    epoch_acc = correct / total\n    if profile:\n        print(f\"Validation time: {val_time:.2f}s\")\n        print(f\"Validation loss: {epoch_loss:.4f}, accuracy: {epoch_acc:.4f}\")\n    return epoch_loss, epoch_acc\n\ndef objective(trial, model, train_loader, val_loader, device, num_epochs=10):\n    lr = trial.suggest_float('lr', 1e-5, 1e-3, log=True)\n    weight_decay = trial.suggest_float('weight_decay', 1e-6, 1e-2, log=True)\n    optimizer = optim.Adam(model.parameters(), lr=lr, weight_decay=weight_decay)\n    criterion = nn.CrossEntropyLoss()\n    scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='min', patience=3, factor=0.5)\n    best_acc = 0.0\n    for epoch in range(1, num_epochs+1):\n        train_loss, train_acc = train_epoch(model, train_loader, optimizer, criterion, device)\n        val_loss, val_acc = validate(model, val_loader, criterion, device)\n        scheduler.step(val_loss)\n        trial.report(val_acc, epoch)\n        if trial.should_prune():\n            raise optuna.TrialPruned()\n        if val_acc > best_acc:\n            best_acc = val_acc\n    return best_acc\n\ndef run_optuna(model, train_loader, val_loader, device, num_epochs=10, n_trials=10):\n    study = optuna.create_study(direction='maximize', pruner=optuna.pruners.MedianPruner())\n    study.optimize(lambda trial: objective(trial, model, train_loader, val_loader, device, num_epochs), n_trials=n_trials)\n    return study.best_params, study.best_value","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# main.ipynb - полный пайплайн с использованием всех возможностей\n\n# ==================== Установка и импорт ====================\n# !pip install kagglehub torchinfo torchmetrics optuna opencv-python-headless scikit-learn\n!pip install decord\n\nimport os\nimport random\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport warnings\nwarnings.filterwarnings('ignore')\n\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader\nfrom torchvision import transforms, models\nimport kagglehub\nfrom sklearn.model_selection import train_test_split\nfrom tqdm import tqdm\nimport cv2\nimport optuna\nfrom torchinfo import summary\n\n# Настройка воспроизводимости\ndef set_seed(seed=42):\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed_all(seed)\n    torch.backends.cudnn.deterministic = True\n    torch.backends.cudnn.benchmark = False\n\nset_seed(42)\n\n# Определение устройства и вывод информации о GPU\ndevice = torch.device(\"cuda\")\nprint(\"Using device:\", device)\nif device.type == 'cuda':\n    print(\"GPU Name:\", torch.cuda.get_device_name(0))\n    print(\"GPU Memory:\", torch.cuda.get_device_properties(0).total_memory / 1e9, \"GB\")\n    print(\"Number of GPUs:\", torch.cuda.device_count())\n\n# ==================== Импорт пользовательских модулей ====================\nimport data_loader\nimport model as model_def\nimport train\nimport evaluate\nimport utils\n\n# ==================== Загрузка данных ====================\ndata_root = '/kaggle/input/datasets/farhanabidtech786/deepfake-video-9-6k/CombinedDataset'\nprint(\"Data root:\", data_root)\n!ls {data_root}\n\n\nbatch_size = 128\nnum_frames = 10\ntrain_loader, val_loader = data_loader.get_data_loaders(\n    data_root,\n    batch_size=16,\n    num_frames=5,\n    img_size=(160, 160),\n    max_fake=2000,\n    max_real=2000,\n    num_workers=0,\n    pin_memory=False,\n    device='cuda'\n)\n\n# Покажем несколько примеров кадров\nutils.show_frames(train_loader.dataset, num_videos=2, num_frames=4)\n\n# ==================== Создание модели ====================\nbackbone = 'resnet50'\nmodel = model_def.VideoClassifier(num_classes=2, backbone=backbone, pretrained=True)\n\n# Вывод архитектуры модели\ntorch.cuda.empty_cache()\nsummary(model, input_size=(batch_size, num_frames, 3, 224, 224), device='cuda')\n\nif torch.cuda.device_count() > 1:\n    print(f\"Using {torch.cuda.device_count()} GPUs with DataParallel\")\n    model = nn.DataParallel(model)\nmodel = model.to(device)\n\ncriterion = nn.CrossEntropyLoss()\noptimizer = optim.Adam(model.parameters(), lr=1e-4)\nscheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='min', patience=3, factor=0.5)\n\n# ==================== Обучение ====================\nnum_epochs = 10\nbest_val_acc = 0.0\nmodel_dir = 'saved_models'\nos.makedirs(model_dir, exist_ok=True)\n\ntrain_losses, val_losses = [], []\ntrain_accs, val_accs = [], []\n\nfor epoch in range(1, num_epochs+1):\n    train_loss, train_acc = train.train_epoch(\n        model, train_loader, optimizer, criterion, device,\n        profile=(epoch == 1)  # только первая эпоха\n    )\n    val_loss, val_acc = train.validate(\n        model, val_loader, criterion, device,\n        profile=(epoch == 1)\n    )\n    scheduler.step(val_loss)\n    train_losses.append(train_loss)\n    val_losses.append(val_loss)\n    train_accs.append(train_acc)\n    val_accs.append(val_acc)\n    print(f\"Epoch {epoch}/{num_epochs} | Train Loss: {train_loss:.4f} Acc: {train_acc:.4f} | Val Loss: {val_loss:.4f} Acc: {val_acc:.4f}\")\n    \n    if val_acc > best_val_acc:\n        best_val_acc = val_acc\n        best_model_path = os.path.join(model_dir, f'best_model_acc_{val_acc:.4f}.pth')\n        torch.save(model.state_dict(), best_model_path)\n        print(f\"New best model saved to {best_model_path}\")\n\nfinal_model_path = os.path.join(model_dir, f'final_model_acc_{val_acc:.4f}.pth')\ntorch.save(model.state_dict(), final_model_path)\nprint(f\"Final model saved to {final_model_path}\")\n\n# Графики обучения\nutils.plot_training_history(train_losses, val_losses, train_accs, val_accs)\n\n# ==================== Оценка ====================\nbest_model_files = [f for f in os.listdir(model_dir) if f.startswith('best_model_acc_')]\nif best_model_files:\n    best_file = sorted(best_model_files, key=lambda x: float(x.split('_')[-1].replace('.pth','')), reverse=True)[0]\n    best_path = os.path.join(model_dir, best_file)\n    model.load_state_dict(torch.load(best_path))\n    print(f\"Loaded best model 